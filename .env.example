# ---- Shopify App Proxy (HTML requests are HMAC-verified with this) ----
SHOPIFY_API_SECRET=
# Local dev / preview only. NEVER set in production (ignored there anyway).
ALLOW_UNSIGNED=0

# ---- Asset URLs served to the browser (written by `npm run refresh-asset-urls`) ----
ASSET_CSS_URL=
ASSET_JS_URL=

# ---- CI only: uploading hashed assets to Shopify ----
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=            # custom-app Admin API token; scope: write_files (or write_themes for ASSET_HOME=theme)
ASSET_HOME=files                # files (recommended) | theme
SHOPIFY_THEME_ID=               # only for ASSET_HOME=theme

# ---- CI only: pushing asset URLs to Vercel and redeploying ----
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_DEPLOY_HOOK_URL=
