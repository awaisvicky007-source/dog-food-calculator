{
  "name": "pawvortex-dog-food-calculator",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "PawVortex Dog Food & Nutrition Calculator 2.0 - free, no login, no payment, citations from government / veterinary authorities only.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "whitelist": "tsx scripts/check-whitelist.ts",
    "upload-assets": "tsx scripts/upload-assets.ts",
    "refresh-asset-urls": "tsx scripts/refresh-asset-urls.ts",
    "ci": "npm run typecheck && npm run test && npm run whitelist && npm run build"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "@vercel/node": "^3.2.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
